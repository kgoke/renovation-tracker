{
  "expo": {
    "name": "Renovation Tracker",
    "slug": "renovation-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "renovationtracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.renovationtracker.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of receipts and rooms to track your renovation projects.",
        "NSPhotoLibraryUsageDescription": "Attach existing photos of receipts and rooms to your renovation projects."
      }
    },
    "android": {
      "package": "com.renovationtracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#173F35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173F35",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach existing photos of receipts and rooms to your renovation projects.",
          "cameraPermission": "Take photos of receipts and rooms to track your renovation projects."
        }
      ]
    ]
  }
}
